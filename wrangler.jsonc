{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "woorione-hyperdrive-api",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/twilio/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "phone-db" }
  ]
}
